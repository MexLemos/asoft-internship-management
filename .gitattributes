# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Code and text files (enforce LF for PHP/Linux server compatibility)
*.php text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.js text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.env text eol=lf
*.env.* text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.htaccess text eol=lf

# Binary files (do not modify line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.rar binary
*.7z binary
*.woff binary
*.woff2 binary
*.ttf binary
