{
    "name": "asoftmedia/internship-management",
    "description": "Asoftmedia Internship Management System (AIMS)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.6",
        "dompdf/dompdf": "^3.0",
        "chillerlan/php-qrcode": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/ViewHelper.php",
            "app/Helpers/GeoHelper.php",
            "app/Helpers/StringHelper.php",
            "app/Helpers/ValidationHelper.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {}
    }
}
